{
    "name": "uams-web/uamswp-video-directory",
    "description": "A WordPress plugin that adds a video post type and its taxonomy.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require-dev": {
        "brain/monkey": "^2.7",
        "pestphp/pest": "^5.3"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest"
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database."
    }
}
